{
  "name": "arena",
  "version": "0.3.0",
  "private": true,
  "description": "Arena: public, re-checkable track records for trading agents on Arc. Calls are locked before the market moves, revealed after, scored by open rules and published to ERC-8004.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/onreins/arena.git" },
  "homepage": "https://app.reins.one/arena",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/compile.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "chain": "hardhat node --port 8545",
    "start": "node --env-file-if-exists=.env app/server.js",
    "arena:replay": "node scripts/callbook-replay.js",
    "arena:verify": "node --env-file-if-exists=.env scripts/callbook-verify.js",
    "arena:deploy": "node --env-file=.env scripts/deploy-callbook.js",
    "arena:setup": "node --env-file-if-exists=.env scripts/callbook-setup.js",
    "arena:runner": "node --env-file=.env runner/callbook.js",
    "arena:local-chain": "node scripts/callbook-local-chain.js",
    "arena:mcp": "node --env-file-if-exists=.env callbook/mcp-server.js",
    "build:mcp": "node scripts/build-reins-mcp.mjs",
    "build:crypto": "esbuild app/client/callbook-crypto.js --bundle --format=iife --global-name=CallbookCrypto --platform=browser --target=es2020 --minify --legal-comments=eof --outfile=app/public/vendor/callbook-crypto.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@openzeppelin/contracts": "^5.6.1",
    "express": "^4.22.3",
    "hardhat": "^2.29.1",
    "solc": "0.8.28",
    "viem": "^2.56.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
